{
  "manifest_version": 3,
  "name": "Timery",
  "version": "3.3.0",
  "description": "تایمر، کرنومتر و یادآور هوشمند که بین بستن مرورگر هم ادامه پیدا می‌کند + نمایش روی صفحه وب",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Timery — تایمر و یادآور",
    "default_icon": {
      "16": "icons/clock.png",
      "48": "icons/clock.png",
      "128": "icons/clock.png"
    }
  },
  "icons": {
    "16": "icons/clock.png",
    "48": "icons/clock.png",
    "128": "icons/clock.png"
  },
  "permissions": [
    "notifications",
    "alarms",
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "commands": {
    "quick-timer-5": {
      "suggested_key": { "default": "Ctrl+Shift+5" },
      "description": "شروع سریع تایمر ۵ دقیقه"
    },
    "quick-timer-25": {
      "suggested_key": { "default": "Ctrl+Shift+2" },
      "description": "شروع سریع تایمر ۲۵ دقیقه (پومودورو)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content_overlay.js",
        "alarm.mp3",
        "icons/clock.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
